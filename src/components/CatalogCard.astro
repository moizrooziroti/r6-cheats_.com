---
import type { IconName } from './icons/types';
import Icon from './icons/Icon.astro';
import { Badge } from '@/components/starwind/badge';
import { Button } from '@/components/starwind/button';
import {
  Card,
  CardContent,
  CardFooter,
  CardHeader,
  CardTitle,
} from '@/components/starwind/card';

interface Props {
  label: string;
  title: string;
  href: string;
  buyUrl: string;
  features: string[];
  more?: number;
  icon?: IconName;
  badge?: string;
  variant?: 'essential' | 'popular' | 'limited';
  buyLabel?: string;
  viewLabel?: string;
  maxFeatures?: number;
  class?: string;
  /** 'top' — show price above Buy (first product card). 'inside' — price + blurb in card body (others). */
  pricePlacement?: 'top' | 'inside';
  priceText?: string;
  shortInfo?: string;
}

const {
  label,
  title,
  href,
  buyUrl,
  features,
  more = 0,
  icon = 'package',
  badge,
  variant,
  buyLabel = 'Buy now',
  viewLabel = 'View details',
  maxFeatures = 10,
  class: className,
  pricePlacement = 'inside',
  priceText,
  shortInfo,
} = Astro.props;

const displayFeatures = features.slice(0, maxFeatures);
const buyRel = 'sponsored noopener noreferrer';

const statusBadgeIcon = (text: string): IconName => {
  if (/limited/i.test(text)) return 'alert';
  if (/private/i.test(label)) return 'shieldCheck';
  return 'circleCheck';
};
---

<Card class:list={['group flex h-full flex-col transition-shadow hover:shadow-md', className]}>
  <CardHeader class="space-y-2.5">
    {
      pricePlacement === 'top' && priceText && (
        <p class="text-xs font-semibold uppercase tracking-wide text-primary tabular-nums" data-catalog-price-top>
          {priceText}
        </p>
      )
    }
    <CardTitle class="text-lg normal-case leading-snug">
      <a href={href} class="hover:text-primary">{title}</a>
    </CardTitle>
    <div class="catalog-card__badges flex flex-wrap items-center gap-1.5">
      <Badge tone="primary" appearance="outline" size="sm" class="catalog-card__badge gap-1">
        <Icon name={icon} size={12} class="shrink-0" />
        {label}
      </Badge>
      {
        badge && (
          <Badge
            tone={/limited/i.test(badge) ? 'warning' : 'success'}
            appearance="soft"
            size="sm"
            class="catalog-card__badge gap-1"
          >
            <Icon name={statusBadgeIcon(badge)} size={12} class="shrink-0" />
            {badge}
          </Badge>
        )
      }
      {variant === 'popular' && (
        <Badge tone="primary" appearance="solid" size="sm" class="catalog-card__badge gap-1">
          <Icon name="zap" size={12} class="shrink-0" />
          Popular
        </Badge>
      )}
      {
        variant === 'limited' && !badge?.toLowerCase().includes('limited') && (
          <Badge tone="warning" appearance="outline" size="sm" class="catalog-card__badge gap-1">
            <Icon name="alert" size={12} class="shrink-0" />
            Limited
          </Badge>
        )
      }
    </div>
    {
      pricePlacement === 'top' && (
        <div class="flex flex-col gap-2 sm:flex-row">
          <Button
            as="a"
            href={buyUrl}
            target="_blank"
            rel={buyRel}
            variant="primary"
            size="sm"
            class="w-full sm:flex-1"
          >
            {buyLabel}
            <Icon name="arrowRight" size={17} />
          </Button>
          <Button as="a" href={href} variant="outline" size="sm" class="w-full sm:flex-1">
            {viewLabel}
            <Icon name="arrowRight" size={17} />
          </Button>
        </div>
      )
    }
  </CardHeader>
  <CardContent class="flex-1">
    {
      pricePlacement === 'inside' && priceText && (
        <div class="mb-4 rounded-xl border border-border/80 bg-muted/30 px-3 py-2.5">
          <p class="text-lg font-bold tabular-nums text-foreground">{priceText}</p>
          {shortInfo && <p class="mt-1 text-xs leading-snug text-muted-foreground">{shortInfo}</p>}
        </div>
      )
    }
    <ul class="space-y-2 text-sm text-muted-foreground">
      {displayFeatures.map((feature) => (
        <li class="flex items-start gap-2">
          <Icon name="check" size={14} class="mt-0.5 shrink-0" />
          <span>{feature}</span>
        </li>
      ))}
      {more > 0 && <li class="text-xs text-muted-foreground">+{more} more features</li>}
    </ul>
  </CardContent>
  {
    pricePlacement === 'inside' && (
      <CardFooter class="flex flex-col gap-2 sm:flex-row">
        <Button
          as="a"
          href={buyUrl}
          target="_blank"
          rel={buyRel}
          variant="primary"
          size="sm"
          class="w-full sm:flex-1"
        >
          {buyLabel}
          <Icon name="arrowRight" size={17} />
        </Button>
        <Button as="a" href={href} variant="outline" size="sm" class="w-full sm:flex-1">
          {viewLabel}
          <Icon name="arrowRight" size={17} />
        </Button>
      </CardFooter>
    )
  }
</Card>
