---
import { t } from '../i18n';
import { ROUTES } from '../utils/path';
import { PRIMARY_BUY_URL } from '../config/checkout';
import { compatibilityIcons, heroStatIcons, heroStatusPills } from '../data/sectionIcons';
import { HERO_VIDEO_URL } from '../config/siteMedia';
import Icon from './icons/Icon.astro';
import { Button } from '@/components/starwind/button';
import { Badge } from '@/components/starwind/badge';

const h = t.hero;

const heroMarqueePills = [
  ...heroStatusPills,
  ...t.compatibility.items.map((label, i) => ({
    label,
    icon: compatibilityIcons[i] ?? 'check',
  })),
];
---

<section
  id="hero"
  class="relative overflow-hidden border-b border-border"
  aria-labelledby="hero-title"
>
  <div class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_top,var(--primary)_0%,transparent_55%)] opacity-20" aria-hidden="true" />

  <div class="relative mx-auto flex max-w-6xl flex-col justify-center px-5">
    <div class="grid items-center gap-10 lg:grid-cols-2 lg:gap-14">
      <div class="w-full max-w-xl space-y-6 text-left md:space-y-7 lg:max-w-2xl">
        <Badge variant="secondary" class="uppercase tracking-wider">{h.eyebrow}</Badge>

        <h1 id="hero-title" class="text-4xl font-bold uppercase leading-tight md:text-5xl">
          <span class="block text-foreground">{h.titleLine1}</span>
          <span class="block text-primary">{h.titleLine2}</span>
        </h1>

        <p class="max-w-xl text-sm leading-relaxed text-neutral-500 dark:text-neutral-400 md:text-base">
          {h.subtitle}
        </p>

        <div class="flex flex-wrap justify-start gap-3 sm:gap-4">
          <Button
            as="a"
            href={ROUTES.products}
            data-scroll-target="products"
            variant="primary"
            size="lg"
            class="rounded-xl"
          >
            {h.ctaPrimary}
            <Icon name="arrowRight" size={18} />
          </Button>
          <Button
            as="a"
            href={PRIMARY_BUY_URL}
            target="_blank"
            rel="sponsored noopener noreferrer"
            variant="secondary"
            size="lg"
            class="rounded-xl"
          >
            <Icon name="messageCircle" size={18} />
            {h.ctaDiscord}
          </Button>
        </div>
      </div>

      <div class="mx-auto flex w-full max-w-xl flex-col items-center gap-5 lg:mx-0 lg:max-w-none lg:items-end">
        <div class="relative hidden w-full overflow-hidden rounded-xl border border-border bg-black shadow-lg ring-1 ring-white/5 lg:block">
          <div class="pointer-events-none absolute inset-0 bg-gradient-to-t from-background/80 via-transparent to-transparent" aria-hidden="true" />
          <video
            class="aspect-video w-full object-cover"
            autoplay
            muted
            loop
            playsinline
            controls
            controlslist="nodownload"
            preload="metadata"
            aria-label="Rainbow Six Siege gameplay preview — muted; enable sound if needed"
          >
            <source src={HERO_VIDEO_URL} type="video/mp4" />
          </video>
        </div>
        <p class="hidden max-w-md text-center text-[11px] leading-snug text-muted-foreground lg:block">
          Preview clip for context only — not a gameplay endorsement. Listing features and risk still apply; use sound controls if your browser unmutes.
        </p>
        <div class="grid w-full grid-cols-2 gap-2.5 sm:gap-3 md:grid-cols-4 lg:grid-cols-2">
          {h.metrics.map((m, i) => (
            <div class="flex min-w-0 items-center gap-3 rounded-xl border border-border/80 bg-card/70 px-3 py-3 shadow-sm shadow-black/10 transition-colors hover:border-primary/40">
              <span
                class="flex size-10 shrink-0 items-center justify-center rounded-lg bg-primary/15 ring-1 ring-inset ring-primary/25"
                aria-hidden="true"
              >
                <Icon name={heroStatIcons[i] ?? 'check'} size={18} />
              </span>
              <div class="min-w-0">
                <p class="font-[family-name:var(--font-heading)] text-base font-bold leading-none tracking-tight text-foreground">{m.strong}</p>
                <p class="mt-1 text-xs leading-tight text-muted-foreground">{m.label}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>

    <div class="hero-status-marquee relative mt-10 md:mt-12 lg:mt-14" aria-label="Features and platform support">
      <div class="pointer-events-none absolute inset-y-0 left-0 z-10 w-12 bg-gradient-to-r from-background to-transparent" aria-hidden="true" />
      <div class="pointer-events-none absolute inset-y-0 right-0 z-10 w-12 bg-gradient-to-l from-background to-transparent" aria-hidden="true" />
      <div class="hero-status-marquee-track flex w-max gap-2">
        {[...heroMarqueePills, ...heroMarqueePills].map((pill, i) => (
          <Badge variant="outline" class="group/badge shrink-0 gap-1 py-0.5 pl-1.5 pr-2.5 text-xs whitespace-nowrap">
            <Icon name={pill.icon} size={13} />
            {pill.label}
          </Badge>
        ))}
      </div>
    </div>
  </div>
</section>
