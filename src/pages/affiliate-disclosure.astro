---
import BaseLayout from '../layouts/BaseLayout.astro';
import { t } from '../i18n';
import { resolvePageSeo } from '../config/seo';
import { breadcrumbSchema, webPageSchema } from '../utils/schema';
import Breadcrumbs from '../components/Breadcrumbs.astro';
import SectionHeader from '../components/SectionHeader.astro';
import { Prose } from '@/components/starwind/prose';

const page = t.legalPages.affiliateDisclosure;
const seo = resolvePageSeo('/affiliate-disclosure/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: page.title, path: '/affiliate-disclosure/' },
];
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    webPageSchema({
      name: page.title,
      description: page.description,
      url: '/affiliate-disclosure/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="border-b border-border bg-muted/10 py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <div class="mt-6 max-w-3xl">
        <SectionHeader eyebrow="Legal" title={page.title} desc={page.description} titleId="affiliate-disclosure-title" as="h1" />
      </div>
    </div>
  </section>
  <section class="py-10 md:py-14">
    <div class="mx-auto max-w-3xl px-5">
      <Prose class="max-w-none">
        {page.sections.map((section) => (
          <div class="mb-10">
            <h2 class="text-xl font-bold">{section.heading}</h2>
            {section.paragraphs.map((p) => (
              <p class="mt-3 text-muted-foreground leading-relaxed">{p}</p>
            ))}
          </div>
        ))}
      </Prose>
    </div>
  </section>
</BaseLayout>
