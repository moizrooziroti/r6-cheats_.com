---
import '../../styles/forum.css';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import ResponsiveImage from '../../components/ResponsiveImage.astro';
import Icon from '../../components/icons/Icon.astro';
import { forumCategories, forumPosts } from '../../data/forum';
import { blogPosts, getBlogPostTimestamp } from '../../data/blog';
import { resolvePageSeo } from '../../config/seo';
import { breadcrumbSchema, collectionPageSchema } from '../../utils/schema';
import { ROUTES, forumThreadPath } from '../../utils/path';
import { t } from '../../i18n';

const seo = resolvePageSeo('/forums/');
const breadcrumbs = [
  { name: 'Home', path: '/' },
  { name: 'Forums', path: '/forums/' },
];
const categoryKey = (name: string) => name.toLowerCase().replace(/[^a-z0-9]/g, '');

function threadSortTime(post: (typeof forumPosts)[number]): number {
  if (post.relatedArticle) {
    const slug = post.relatedArticle.path.replace(/^\/articles\/|\/$/g, '');
    const article = blogPosts.find((item) => item.slug === slug);
    if (article) return getBlogPostTimestamp(article.date);
  }
  return post.published;
}

const communitySlug = (category: string) => `r6/${category.toLowerCase().replaceAll(' ', '')}`;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  jsonLd={[
    collectionPageSchema({
      name: 'R6-Cheats forums',
      description: seo.description,
      url: '/forums/',
    }),
    breadcrumbSchema(breadcrumbs),
  ]}
>
  <section class="forum-page py-8 md:py-12">
    <div class="mx-auto max-w-6xl px-5">
      <Breadcrumbs items={breadcrumbs} />
      <header class="forum-hero">
        <div>
          <p class="section-header__eyebrow">Rainbow Six Siege</p>
          <h1>R6 cheats forums</h1>
          <p class="forum-hero__copy">
            Threads on r6-cheats.com about the four offers we actually sell: Siege cheats, the HWID spoofer, UGC recovery, and
            Cloud DMA. Read a thread, then open the matching product page before you pay.
          </p>
        </div>
        <a class="forum-create" href={ROUTES.articles}
          ><Icon name="messageCircle" size={17} /> Browse articles</a
        >
      </header>

      <div class="forum-layout">
        <main class="forum-main" aria-label="Forum threads">
          <div class="forum-toolbar">
            <div class="forum-sort" role="group" aria-label="Thread sorting">
              <button class="is-active" type="button" data-forum-sort="popular" aria-pressed="true">Popular</button>
              <button type="button" data-forum-sort="latest" aria-pressed="false">Latest</button>
              <button type="button" data-forum-sort="top" aria-pressed="false">Most discussed</button>
            </div>
            <label class="forum-search">
              <Icon name="search" size={16} />
              <input type="search" placeholder="Search threads" aria-label="Search threads" data-forum-search />
              <span class="sr-only" data-forum-count>{forumPosts.length} threads</span>
            </label>
          </div>

          <div class="forum-category-filters" role="group" aria-label="Filter threads by topic">
            <button type="button" class="is-active" data-forum-filter="all" aria-pressed="true"
              ><Icon name="layers" size={14} /> All topics</button
            >
            {
              forumCategories.map((category) => (
                <button type="button" data-forum-filter={categoryKey(category.name)} aria-pressed="false">
                  <Icon name={category.icon} size={14} /> {category.name}
                </button>
              ))
            }
          </div>
          <p class="forum-results-count" data-forum-visible-count>{forumPosts.length} threads</p>

          <div class="forum-post-list" aria-live="polite">
            {forumPosts.map((post, index) => (
              <article
                class="forum-post-card"
                data-forum-card
                data-post-slug={post.slug}
                data-upvotes={post.upvotes}
                data-category={categoryKey(post.category)}
                data-comments={post.commentsCount}
                data-published={threadSortTime(post)}
                data-order={index}
              >
                <div class="forum-vote" aria-label="Thread voting">
                  <button class="forum-vote__up" type="button" data-vote-up aria-label="Upvote this thread"
                    ><Icon name="chevronDown" size={16} /></button
                  >
                  <strong data-vote-count>{post.upvotes}</strong>
                  <button type="button" disabled aria-label="Downvoting is unavailable"
                    ><Icon name="chevronDown" size={16} /></button
                  >
                </div>
                <div class="forum-post-thumb">
                  <a href={forumThreadPath(post.slug)} aria-hidden="true" tabindex={-1} class="forum-post-thumb__link">
                    <ResponsiveImage
                      src={post.coverImage}
                      alt={post.title}
                      width={220}
                      height={124}
                      loading="lazy"
                      sizes="(max-width: 520px) 72px, 110px"
                      class="forum-post-thumb__img"
                    />
                  </a>
                </div>
                <div class="forum-post-card__body">
                  <div class="forum-post-meta">
                    <span class={`forum-community-avatar tone-${post.categoryTone}`}
                      ><Icon name="users" size={15} /></span
                    >
                    <a href="#communities" class="forum-community-name">{communitySlug(post.category)}</a>
                    <span>·</span><span><Icon name="userRound" size={13} /> {post.author}</span><span>{post.commentsCount} replies</span>
                  </div>
                  <a class="forum-post-title" href={forumThreadPath(post.slug)}>{post.title}</a>
                  <p class="forum-post-excerpt">{post.excerpt}</p>
                  {
                    post.relatedArticle && (
                      <p class="forum-source">
                        Related article:{' '}
                        <a href={post.relatedArticle.path}>{post.relatedArticle.title}</a>
                      </p>
                    )
                  }
                  <div class="forum-post-actions">
                    {post.flair && <span class={`forum-flair tone-${post.categoryTone}`}>{post.flair}</span>}
                    <a href={forumThreadPath(post.slug)}
                      ><Icon name="messageCircle" size={15} /> {post.commentsCount} replies</a
                    >
                    <a href={forumThreadPath(post.slug)}><Icon name="arrowRight" size={15} /> Read thread</a>
                  </div>
                </div>
              </article>
            ))}
          </div>
          <p class="forum-empty" data-forum-empty hidden>No threads match. Try another search or topic.</p>
          <nav class="forum-pagination" aria-label="Thread pages" data-forum-pagination hidden>
            <button type="button" data-page-previous aria-label="Previous page">Previous</button>
            <div class="forum-pagination__pages" data-page-buttons></div>
            <button type="button" data-page-next aria-label="Next page">Next</button>
            <span class="forum-pagination__status" data-page-status aria-live="polite"></span>
          </nav>
        </main>

        <aside class="forum-sidebar">
          <section class="forum-side-card forum-about" id="community-guidelines">
            <div class="forum-side-card__banner"></div>
            <div class="forum-about__content">
              <div class="forum-about__title">
                <span class="forum-community-avatar forum-community-avatar--brand"
                  ><img src="/logo.svg" alt="" width="34" height="34" /></span
                ><h2>{t.site.name}</h2>
              </div>
              <p>Threads summarize common buyer questions for Rainbow Six Siege tools — paired with our articles and product pages.</p>
              <div class="forum-stats">
                <span
                  ><b>{forumPosts.length}</b> threads</span
                ><span
                  ><b>{forumCategories.length}</b> topics</span
                >
              </div>
              <a class="forum-join" href={ROUTES.articles}>Read all articles</a>
            </div>
          </section>
          <section class="forum-side-card" id="communities">
            <h2 class="forum-side-heading">Topics</h2>
            <ul class="forum-community-list">
              {forumCategories.map((category) => (
                <li>
                  <a href={`/forums/?category=${categoryKey(category.name)}`}
                    ><span class={`forum-community-avatar tone-${category.tone}`} aria-hidden="true"
                      ><Icon name={category.icon} size={15} /></span
                    ><span
                      ><b>{category.name}</b><small>Browse related threads</small></span
                    ><Icon name="chevronRight" size={15} /></a
                  >
                </li>
              ))}
            </ul>
            <a class="forum-text-link" href="#communities">Browse topics <Icon name="arrowRight" size={14} /></a>
          </section>
          <section class="forum-side-card forum-rules">
            <h2 class="forum-side-heading">Community guidelines</h2>
            <ol>
              <li>Keep it neutral and on-topic</li>
              <li>No outcome or detection claims</li>
              <li>Threads are editorial, not verified purchases</li>
            </ol>
            <a href="#community-guidelines">Back to top <Icon name="arrowRight" size={14} /></a>
          </section>
          <p class="forum-sidebar-foot">
            <a href="/affiliate-disclosure/">Affiliate disclosure</a> · <a href="/privacy/">Privacy</a> ·{' '}
            <a href="/terms/">Terms</a>
            <br />© {new Date().getFullYear()} {t.site.name}
          </p>
        </aside>
      </div>
    </div>
  </section>
  <script>
    const cards = [...document.querySelectorAll('[data-forum-card]')];
    const sortButtons = [...document.querySelectorAll('[data-forum-sort]')];
    const filterButtons = [...document.querySelectorAll('[data-forum-filter]')];
    const searchInput = document.querySelector('[data-forum-search]');
    const list = document.querySelector('.forum-post-list');
    const pagination = document.querySelector('[data-forum-pagination]');
    const pageButtons = document.querySelector('[data-page-buttons]');
    const pageStatus = document.querySelector('[data-page-status]');
    const countStatus = document.querySelector('[data-forum-count]');
    const visibleCount = document.querySelector('[data-forum-visible-count]');
    const emptyState = document.querySelector('[data-forum-empty]');
    const previousButton = document.querySelector('[data-page-previous]');
    const nextButton = document.querySelector('[data-page-next]');
    const pageSize = 20;
    let currentPage = 1;
    let activeFilter = new URLSearchParams(window.location.search).get('category') ?? 'all';

    function updateForum() {
      const sort = sortButtons.find((button) => button.getAttribute('aria-pressed') === 'true')?.dataset.forumSort ?? 'popular';
      const query = searchInput?.value.trim().toLocaleLowerCase() ?? '';
      const ordered = [...cards].sort((a, b) => {
        if (sort === 'latest') return Number(b.dataset.published) - Number(a.dataset.published);
        if (sort === 'top') return Number(b.dataset.comments) - Number(a.dataset.comments);
        return Number(a.dataset.order) - Number(b.dataset.order);
      });
      const matching = ordered.filter((card) => {
        const matchesCategory = activeFilter === 'all' || card.dataset.category === activeFilter;
        return matchesCategory && (!query || card.textContent?.toLocaleLowerCase().includes(query));
      });
      const pageCount = Math.max(1, Math.ceil(matching.length / pageSize));
      currentPage = Math.min(currentPage, pageCount);
      const firstVisible = (currentPage - 1) * pageSize;
      const visibleCards = new Set(matching.slice(firstVisible, firstVisible + pageSize));

      ordered.forEach((card) => {
        card.hidden = !visibleCards.has(card);
        list?.append(card);
      });

      if (countStatus) countStatus.textContent = `${matching.length} ${matching.length === 1 ? 'thread' : 'threads'}`;
      if (visibleCount) visibleCount.textContent = `${matching.length} ${matching.length === 1 ? 'thread' : 'threads'}`;
      if (emptyState) emptyState.hidden = matching.length > 0;
      if (pagination) pagination.hidden = matching.length <= pageSize;
      if (pageStatus)
        pageStatus.textContent = matching.length
          ? `Showing ${firstVisible + 1}–${Math.min(firstVisible + pageSize, matching.length)} of ${matching.length}`
          : '0 threads';
      if (previousButton) previousButton.disabled = currentPage <= 1;
      if (nextButton) nextButton.disabled = currentPage >= pageCount;
      if (pageButtons) {
        pageButtons.replaceChildren(
          ...Array.from({ length: pageCount }, (_, index) => {
            const button = document.createElement('button');
            const page = index + 1;
            button.type = 'button';
            button.textContent = String(page);
            button.setAttribute('aria-label', `Page ${page}`);
            if (page === currentPage) button.setAttribute('aria-current', 'page');
            button.addEventListener('click', () => {
              currentPage = page;
              updateForum();
            });
            return button;
          }),
        );
      }
    }

    sortButtons.forEach((button) =>
      button.addEventListener('click', () => {
        sortButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        currentPage = 1;
        updateForum();
      }),
    );

    filterButtons.forEach((button) =>
      button.addEventListener('click', () => {
        activeFilter = button.dataset.forumFilter ?? 'all';
        filterButtons.forEach((item) => {
          const active = item === button;
          item.classList.toggle('is-active', active);
          item.setAttribute('aria-pressed', String(active));
        });
        currentPage = 1;
        updateForum();
      }),
    );

    searchInput?.addEventListener('input', () => {
      currentPage = 1;
      updateForum();
    });
    previousButton?.addEventListener('click', () => {
      currentPage = Math.max(1, currentPage - 1);
      updateForum();
    });
    nextButton?.addEventListener('click', () => {
      currentPage += 1;
      updateForum();
    });

    const initialFilter = filterButtons.find((button) => button.dataset.forumFilter === activeFilter);
    if (initialFilter) {
      filterButtons.forEach((item) => {
        const active = item === initialFilter;
        item.classList.toggle('is-active', active);
        item.setAttribute('aria-pressed', String(active));
      });
    } else {
      activeFilter = 'all';
    }
    updateForum();
  </script>
  <script>
    import { initForumVotes } from '../../scripts/forum-votes.ts';
    initForumVotes();
  </script>
</BaseLayout>
